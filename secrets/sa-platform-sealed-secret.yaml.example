# Replace this example with a SealedSecret encrypted using the target cluster's
# kubeseal public certificate. Commit it as secrets/sa-platform-sealed-secret.yaml.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: sa-platform-secret
  namespace: sa-p8
spec:
  encryptedData:
    postgres-password: REPLACE_WITH_KUBESEAL_OUTPUT
    appointments-write-token: REPLACE_WITH_KUBESEAL_OUTPUT
  template:
    metadata:
      name: sa-platform-secret
      namespace: sa-p8
    type: Opaque
